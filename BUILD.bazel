load('@npm_root//:defs.bzl', 'npm_link_all_packages')

package(default_visibility = ["//visibility:public"])

# nodejs
# We have a multi-project workspace, rules_js dictate we must use
# 'npm_link_all_packages' at the root and in each project.
# See: https://aspect.build/docs/bazel/javascript/pnpm_rules_js
npm_link_all_packages(
    name = 'node_modules',
)
